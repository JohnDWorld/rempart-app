# ===========================================
# REMPART APP - Configuration Environnement
# ===========================================
# Copier ce fichier vers .env et adapter les valeurs
# cp .env.example .env
#
# Ce fichier .env.example est committe dans git (template)
# Le fichier .env est ignore par git (contient vos valeurs locales)

# Mode developpement local (true) ou production (false)
IS_LOCAL=true

# ===========================================
# SUPABASE
# ===========================================
# IP/URL du serveur Supabase
# - Dev local via Tailscale : http://100.97.202.12:54321
# - Production : https://xxx.supabase.co
SUPABASE_URL=http://100.97.202.12:54321

# Cle anonyme Supabase (safe cote client, mais laissee vide ici)
# En dev local : `supabase status` la donne (anon key).
# Sur un serveur auto-heberge : celle de la configuration de la stack.
# Volontairement absente de ce fichier : ce depot est publie, et une valeur qui
# ressemble a un jeton, meme publique, apprend a ne plus s'en mefier.
SUPABASE_ANON_KEY=
# Schema PostgREST du projet. Defaut: public (Supabase local via migrations).
# Sur une base partagee multi-projets (johnserver), mettre le schema dedie, ex: rempart
# SUPABASE_SCHEMA=public

# ===========================================
# MATRIX (Synapse)
# ===========================================
# URL du homeserver Matrix
# - Dev local via Tailscale : http://100.97.202.12:8008
# - Production : https://matrix.rempart.example.com
MATRIX_HOMESERVER=http://100.97.202.12:8008

# server_name de Synapse : la partie qui suit les « : » dans un identifiant
# Matrix. DISTINCTE de l'URL ci-dessus, et jamais devinable a partir d'elle des
# qu'un reverse proxy s'interpose (API sur matrix.rempart.fr, server_name
# rempart.fr). Absente, elle est deduite du homeserver : les identifiants
# fabriques visent alors un serveur qui n'existe pas, et les invitations
# partent dans le vide sans que rien ne le signale.
MATRIX_DOMAIN=100.97.202.12

# BOT GATEWAY (API des bots utilisateurs)
BOT_GATEWAY_URL=http://100.97.202.12:8300

# Boutique a agents : page ou l'on commande un agent sur mesure.
# Vide, l'app retombe sur https://la-boutique-a-agents.com
BOUTIQUE_AGENTS_URL=

# Page de soutien (dons). VIDE = pas d'entree dans les reglages, aucun lien.
# Doit etre une adresse https, sinon elle est ignoree.
#
# Le paiement se fait sur le web et jamais dans l'app : encaisse dans l'app,
# un « soutenez le developpeur » est pour Apple un achat de contenu numerique,
# donc un achat integre, donc une commission. A remplir le jour ou la page
# existe.
DON_URL=

# Mises a jour de l'app hors magasin (Android uniquement).
# Manifeste publie par le serveur de mises a jour (voir rempart-backend/updates).
# VIDE = fonctionnalite entierement desactivee : ni verification, ni bouton.
# Laisser vide pour un build destine a Google Play, qui l'interdit.
UPDATE_MANIFEST_URL=http://100.64.0.11:8086/latest.json

# Email pre-rempli sur l ecran de connexion. CONFORT DE TEST UNIQUEMENT :
# ne renseigner que dans un .env local, jamais dans un build distribue, sinon
# CET email s affiche a tous les utilisateurs de ce build. Absente (defaut) =
# aucun pre-remplissage, l ecran se comporte normalement.
# Confort de developpement : pre-remplit l'ecran de connexion. DOIT rester
# vide pour tout APK distribue, sinon l'adresse du developpeur s'affiche chez
# tous les utilisateurs. publier-apk.sh refuse de construire si elle est
# renseignee.
# DEFAULT_LOGIN_EMAIL=

# ---------------------------------------------------------------------------
# NOTIFICATIONS PUSH
# ---------------------------------------------------------------------------
# Mecanisme par defaut : auto | fcm | unifiedpush | aucun
#   fcm         = variante grand public (Google Play Services, comme WhatsApp)
#   unifiedpush = variante souveraine (aucun service Google)
#   auto        = FCM si configure ci-dessous, sinon UnifiedPush
# L utilisateur peut surcharger ce choix dans les reglages de l app.
PUSH_MODE=auto

# Passerelles appelees PAR SYNAPSE (pas par l app) : adresses resolvables
# depuis le serveur, donc des noms de service Docker.
PUSH_GATEWAY_URL=http://push-gateway:8500/_matrix/push/v1/notify
FCM_GATEWAY_URL=http://sygnal:5000/_matrix/push/v1/notify

# Identifiants Firebase de la variante grand public. Laisser vide desactive
# FCM : la variante souveraine se construit ainsi sans aucun fichier Google.
FCM_API_KEY=
FCM_APP_ID=
FCM_SENDER_ID=
FCM_PROJECT_ID=

# GlitchTip : collecte des rapports de plantage (protocole Sentry, instance
# auto-hebergee). Laisser vide desactive completement l envoi : aucune donnee
# ne quitte l appareil, et l app demarre normalement.
SENTRY_DSN=
